{
    "name": "notebooklm",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "docker:up": "bun run --filter server docker:up",
        "docker:down": "bun run --filter server docker:down",
        "docker:restart": "bun run --filter server docker:restart",
        "docker:logs": "bun run --filter server docker:logs",
        "docker:exec": "bun run --filter server docker:exec",
        "prisma:generate": "bun run --filter server prisma:generate",
        "prisma:migrate": "bun run --filter server prisma:migrate",
        "prisma:studio": "bun run --filter server prisma:studio",
        "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
        "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
        "check-types": "turbo run check-types",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx,js,mjs,cjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,css}": [
            "prettier --write"
        ]
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@repo/eslint-config": "*",
        "eslint": "^9.39.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "prettier": "^3.7.4",
        "turbo": "^2.10.8",
        "typescript": "5.9.2"
    },
    "engines": {
        "node": ">=18"
    },
    "devEngines": {
        "packageManager": {
            "name": "bun",
            "version": "1.3.14"
        }
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ]
}
